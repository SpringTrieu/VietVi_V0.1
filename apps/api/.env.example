# Chung
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_URL_WEB=http://localhost:3000
APP_URL_ADMIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=localhost

# DB
DATABASE_URL=postgres://vietvi:vietvi_dev_secret@localhost:5432/vietvi?sslmode=disable
DATABASE_URL_TEST=postgres://vietvi:vietvi_dev_secret@localhost:5432/vietvi_test?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PUBLIC=vietvi-public
S3_BUCKET_PRIVATE=vietvi-private
UPLOAD_MAX_MB=25

# Email
MAIL_FROM=no-reply@vietvi.vn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Thanh toán
PAYMENT_MODE=MANUAL
PAYMENT_PROVIDER=manual

# Giám sát
SENTRY_DSN=
