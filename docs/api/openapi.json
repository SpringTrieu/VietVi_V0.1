{
  "openapi": "3.0.0",
  "info": {
    "title": "VIETVI API",
    "version": "0.1.0",
    "description": "API hợp đồng cho nền tảng VIETVI"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "vietvi-api"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": ["status", "service", "timestamp"]
                }
              }
            }
          }
        }
      }
    }
  }
}
